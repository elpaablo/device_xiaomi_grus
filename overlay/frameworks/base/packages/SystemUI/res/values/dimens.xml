<resources>
    <!-- Height of the status bar header bar when on Keyguard -->
    <dimen name="status_bar_header_height_keyguard">@*android:dimen/status_bar_height</dimen>
    <!-- Location on the screen of the center of the fingerprint sensor. -->
    <dimen name="physical_fingerprint_sensor_center_screen_location_y">2030px</dimen>
    <!-- Udfps animation -->
    <dimen name="udfps_animation_size">260dp</dimen>
    <dimen name="udfps_animation_offset">-12dp</dimen>
    <dimen name="keyguard_indication_margin_bottom">8dp</dimen>

    <!-- The CPU temperature sensor path, defaults to empty -->
    <string name="config_cpuTempSensor" translatable="false">/sys/class/thermal/thermal_zone13/temp</string>

    <!-- The CPU temperature divider, if needed -->
    <integer name="config_cpuTempDivider" translatable="false">1000</integer>

    <!-- Microns/ums (1000 um = 1mm) per pixel for the given device. If unspecified, UI that
         relies on this value will not be sized correctly. -->
    <item name="pixel_pitch" format="float" type="dimen">58.84</item>

    <!-- temp, it'll be moved to fwb -->
    <dimen name="status_bar_padding_start">6dp</dimen>
</resources>
